# Discord Application Credentials
TOKEN=your_bot_token_here
APP_ID=your_application_id_here
GITHUB_TOKEN=your_github_token_here
GIST_ID=your_gist_id_here
OWNER_IDs=LIST, OF, OWNER, IDS
# Command Group Toggles (true/false)
# Emojis are enabled by default; all others are disabled by default.
ENABLE_EMOJI_COMMANDS=true
ENABLE_FUN_COMMANDS=false
ENABLE_POKEMON_COMMANDS=false
ENABLE_UTILITY_COMMANDS=false