import discord
from discord.ext import commands
from discord import app_commands

@restrict_to_owner
class CustomPrivateCog(commands.Cog):
    def __init__(self, bot):
        self.bot = bot

    @app_commands.allowed_installs(users=True, guilds=False)
    @app_commands.allowed_contexts(
        guilds=True, dms=True, private_channels=True
    )
    @app_commands.command(name="ping", description="Pong from private cog!")
    async def ping_private(self, interaction: discord.Interaction):
        await interaction.response.send_message("Pong from private cog!", ephemeral=True)

async def setup(bot):
    await bot.add_cog(CustomPrivateCog(bot))